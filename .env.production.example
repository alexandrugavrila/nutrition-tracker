# Immutable image references (pin by digest or immutable release tag)
BACKEND_IMAGE=ghcr.io/alexandrugavrila/nutrition-backend:1.2.0-alpha
FRONTEND_IMAGE=ghcr.io/alexandrugavrila/nutrition-frontend:1.2.0-alpha
POSTGRES_IMAGE=postgres:13
# Optional override when using a hardened edge image variant.
EDGE_IMAGE=nginx:1.27-alpine

# Database container credentials (required; inject via secret manager in deployment)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=nutrition

# Backend runtime settings (required secrets should never be committed)
DATABASE_URL=postgresql://<db-user>:<db-password>@db:5432/<db-name>
# Optional: required only for USDA API endpoints, not account operations.
USDA_API_KEY=
# Optional maintenance input for the USDA Foundation Foods one-shot sync service.
# Use a local container path or downloadable FoodData Central JSON URL.
USDA_FOUNDATION_FOODS_JSON=
# Exact trusted browser origins, comma-separated; wildcard does not grant cookie access.
# Include the public HTTPS frontend origin even when using the same-origin proxy.
CORS_ALLOW_ORIGINS=https://your-app.example.com
DB_AUTO_CREATE=false
# Defaults remain HTTPS. For the explicitly selected private HTTP deployment,
# set BOTH false/true respectively and use an exact http:// origin.
SESSION_SECURE_COOKIE=true
ALLOW_INSECURE_HTTP=false

# Internal HTTP edge: put an HTTPS terminator in front; keep direct access restricted.
PROD_HTTP_BIND_ADDRESS=127.0.0.1
PROD_HTTP_PORT=80

# Container runtime sizing defaults (tune per host class)
EDGE_CPUS_LIMIT=0.50
EDGE_MEMORY_LIMIT=256m
EDGE_MEMORY_RESERVATION=128m
BACKEND_CPUS_LIMIT=1.00
BACKEND_MEMORY_LIMIT=768m
BACKEND_MEMORY_RESERVATION=384m
FRONTEND_CPUS_LIMIT=0.50
FRONTEND_MEMORY_LIMIT=256m
FRONTEND_MEMORY_RESERVATION=128m
DB_CPUS_LIMIT=1.50
DB_MEMORY_LIMIT=1g
DB_MEMORY_RESERVATION=512m
